---
import type { TranslationKeys } from "@i18n";

interface Props {
  name: string;
  specialty: string;
  summary: string;
  email: string;
  availability: string;
  location: string;
  t: TranslationKeys;
}

const { name, specialty, summary, email, availability, location, t } = Astro.props;
---

<section class="flex min-h-[70vh] flex-col justify-center gap-8 py-16 md:py-24 animate-slide-up">
  {/* Availability badge */}
  <div class="flex items-center gap-2.5">
    <span class="relative flex h-2.5 w-2.5">
      <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
      <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
    </span>
    <span class="text-sm font-medium text-emerald-600 dark:text-emerald-400">
      {availability}
    </span>
  </div>

  {/* Main heading */}
  <div class="flex flex-col gap-3">
    <h1 class="text-5xl font-bold tracking-tighter text-fg md:text-7xl lg:text-8xl">
      {name}
    </h1>
    <p class="text-xl font-medium text-primary md:text-2xl lg:text-3xl">
      {specialty}
    </p>
  </div>

  {/* Summary */}
  <p class="max-w-2xl text-lg leading-relaxed text-muted-fg md:text-xl">
    {summary}
  </p>

  {/* Location */}
  {location && (
    <div class="flex items-center gap-2 text-sm text-muted-fg">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      {location}
    </div>
  )}

  {/* CTAs */}
  <div class="flex flex-wrap items-center gap-4 pt-4">
    <a
      href={`mailto:${email}`}
      class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-white transition-all hover:bg-primary-700 hover:shadow-lg hover:shadow-primary/25 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-bg"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>
      {t.hero.ctaContact}
    </a>

    <a
      href="#projects"
      class="inline-flex items-center gap-2 rounded-lg border border-border bg-bg px-6 py-3 text-sm font-semibold text-fg transition-all hover:bg-muted hover:border-muted-fg/30 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 focus:ring-offset-bg"
    >
      {t.hero.ctaProjects}
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </a>
  </div>
</section>
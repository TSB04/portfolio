---
import Section from "./Section.astro";
import OptimizedImage from "@components/OptimizedImage.astro";
import type { AboutContent, HeroContent } from "@types";
import type { TranslationKeys } from "@i18n";

type Props = AboutContent & Pick<HeroContent, "name"> & { t: TranslationKeys };

const { description, image, name, t } = Astro.props;
---

<Section text={t.about.title} href="about">
  <div class="flex flex-col items-center gap-12 md:flex-row md:gap-8">
    <p class="w-auto text-base text-muted-fg md:pr-5">{description}</p>
    <div class="h-80 w-64 shrink-0 rotate-[5deg] bg-muted p-4 md:rotate-[7deg]">
      <OptimizedImage
        class="object-cover"
        src={image}
        width={260}
        height={260}
        alt={name}
      />
    </div>
  </div>
</Section>

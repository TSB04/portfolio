---
import { locales, defaultLocale, type Locale } from "../i18n";

export interface Props {
  currentLocale: Locale;
}

const { currentLocale } = Astro.props;

// Build alternate URL
const currentPath = Astro.url.pathname;
const cleanPath = currentPath.replace(/^\/(en|fr)/, "") || "/";

const alternateLocale = currentLocale === "en" ? "fr" : "en";
const alternateUrl = alternateLocale === defaultLocale 
  ? cleanPath 
  : `/${alternateLocale}${cleanPath === "/" ? "" : cleanPath}`;
---

<a
  href={alternateUrl}
  class="group flex items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm font-medium text-white/70 transition-all duration-200 hover:border-white/20 hover:bg-white/10 hover:text-white focus:outline-none focus:ring-2 focus:ring-white/20"
  aria-label={`Switch to ${alternateLocale === "en" ? "English" : "Français"}`}
  title={`Switch to ${alternateLocale === "en" ? "English" : "Français"}`}
>
  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
  </svg>
  <span class="uppercase tracking-wider">{alternateLocale}</span>
</a>
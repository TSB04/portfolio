---
import OptimizedImage from "./OptimizedImage.astro";
import type { ImageMetadata } from "astro";
interface Props { image: ImageMetadata; imageDark?: ImageMetadata; alt: string; width: number; height: number; priority?: boolean }
const { image, imageDark, alt, width, height, priority = false } = Astro.props;
---
<OptimizedImage src={image} {alt} {width} {height} {priority} class={imageDark ? "theme-portrait-light" : undefined} />
{imageDark && <OptimizedImage src={imageDark} {alt} {width} {height} {priority} class="theme-portrait-dark" />}

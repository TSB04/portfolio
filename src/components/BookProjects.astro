---
import CarnetPage from "./CarnetPage.astro";
import OptimizedImage from "./OptimizedImage.astro";
import type { ProjectItem, TranslationKeys } from "@types";
interface Props { projects: ProjectItem[]; t: TranslationKeys; label: string; startIndex: number; total: number }
const { projects, t, label, startIndex, total } = Astro.props;
---
{projects.map((project, index) => <CarnetPage id={index === 0 ? "projects" : `projects-${index + 1}`} index={startIndex + index} total={total} label={`${label} · ${project.name}`} texture="grid"><div class="project-page"><div class="page-heading"><h2>{project.name}</h2><p>Project {String(index + 1).padStart(2, "0")} / {String(projects.length).padStart(2, "0")}</p></div><article class="project-card project-card-featured"><OptimizedImage src={project.image} alt={project.name} width={900} height={480} /><div><p>{project.summary}</p><div class="project-tags">{project.tags.map((tag) => <span class="badge">{tag}</span>)}</div><div class="project-actions">{project.linkSource && <a href={project.linkSource} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">{t.projects.sourceCode}</a>}{project.linkPreview && <a href={project.linkPreview} class="btn btn-primary" target={project.linkPreview.startsWith("http") ? "_blank" : undefined} rel="noopener noreferrer">{t.projects.viewProject} ?</a>}</div></div></article></div></CarnetPage>)}
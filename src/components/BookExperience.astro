---
import CarnetPage from "./CarnetPage.astro";
import type { ExperienceItem, TranslationKeys } from "@types";
interface Props { experience: ExperienceItem[]; t: TranslationKeys; label: string; total: number }
const { experience, t, label, total } = Astro.props;
---
{experience.map((item, index) => <CarnetPage id={index === 0 ? "experience" : `experience-${index + 1}`} index={index + 1} total={total} label={`${label} · ${item.company}`} texture="lines"><div class="page-spread"><div><h2>{t.experiences.title}</h2><p>Role {String(index + 1).padStart(2, "0")} / {String(experience.length).padStart(2, "0")}</p></div><article class="timeline-entry"><p class="page-eyebrow">{item.startDate} — {item.endDate || t.experiences.present}</p><h3>{item.company}</h3><p class="role">{item.position} · {item.location}</p><ul>{item.summary.map((line) => <li>{line}</li>)}</ul><div>{item.technologies.map((tech) => <span class="badge">{tech}</span>)}</div></article></div></CarnetPage>)}
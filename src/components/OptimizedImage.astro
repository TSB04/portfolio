---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  width?: number;
  height?: number;
  loading?: "lazy" | "eager";
  priority?: boolean;
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  loading = "lazy",
  priority = false,
  class: className,
} = Astro.props;


// Public images (/public)
const isExternal = typeof src === "string";
---

{
  isExternal ? (
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={priority ? "eager" : loading}
      decoding="async"
      class={className}
    />
  ) : (
    <Image
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={priority ? "eager" : loading}
      decoding="async"
      class={className}
    />
  )
}
---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  width?: number;
  height?: number;
  loading?: "lazy" | "eager";
  priority?: boolean;
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  loading = "lazy",
  priority = false,
  class: className,
} = Astro.props;


// Public images (/public)
const isExternal = typeof src === "string";
---

{
  isExternal ? (
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={priority ? "eager" : loading}
      decoding="async"
      fetchpriority={priority ? "high" : undefined}
      class={className}
    />
  ) : (
    <Image
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={priority ? "eager" : loading}
      decoding="async"
      fetchpriority={priority ? "high" : undefined}
      widths={width ? [Math.min(360, width), Math.min(640, width), width].filter((value, index, values) => values.indexOf(value) === index) : undefined}
      sizes={width ? `(max-width: 639px) calc(100vw - 3rem), (max-width: 959px) calc(100vw - 6rem), min(45vw, ${width}px)` : undefined}
      class={className}
    />
  )
}

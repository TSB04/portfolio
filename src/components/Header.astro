---
import ThemeToggle from "./ThemeToggle.astro";
import LanguageToggle from "./LanguageToggle.astro";
import OptimizedImage from "@components/OptimizedImage.astro";
import Menu from "@icons/Menu.astro";
import type { Locale } from "../types";

export interface Props {
  siteLogo: ImageMetadata;
  navLinks: { text: string; href: string }[];
  locale?: Locale;
}

const { siteLogo, navLinks, locale = "en" } = Astro.props;

const homeHref = locale === "fr" ? "/fr" : "/";
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent bg-bg/70 backdrop-blur-xl transition-all duration-300"
  transition:persist
>
  <nav class="mx-auto flex h-20 max-w-7xl items-center justify-between px-6">

    <a href={homeHref} class="group">
      <OptimizedImage
        src={siteLogo}
        width={95}
        height={52}
        alt="Logo"
        priority
        class="rounded-full ring-1 ring-border transition duration-300 group-hover:scale-105"
      />
    </a>

    <button
      id="menu-button"
      class="sm:hidden"
      aria-expanded="false"
      aria-controls="main-menu"
    >
      <Menu />
    </button>

    <nav
      id="main-menu"
      class="absolute right-5 top-20 hidden rounded-xl border border-border bg-bg/95 p-5 shadow-xl sm:static sm:block sm:border-0 sm:bg-transparent sm:p-0 sm:shadow-none"
    >
      <ul class="flex flex-col gap-2 sm:flex-row sm:gap-8">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="nav-item relative text-sm font-medium text-muted-fg transition duration-300 hover:text-fg after:absolute after:-bottom-2 after:left-1/2 after:h-[2px] after:w-0 after:-translate-x-1/2 after:bg-primary after:transition-all after:duration-300"
              >
                {link.text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle locale={locale} />
      <LanguageToggle locale={locale} />
    </div>

  </nav>
</header>

<script>
const header = document.getElementById("site-header");
const button = document.getElementById("menu-button");
const menu = document.getElementById("main-menu");
const navItems = [...document.querySelectorAll(".nav-item")];

button?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
});

const updateHeader = () => {

    if (window.scrollY > 10) {
        header?.classList.add("border-border","shadow-lg","bg-bg/90");
        header?.classList.remove("border-transparent","bg-bg/70");
    } else {
        header?.classList.remove("border-border","shadow-lg","bg-bg/90");
        header?.classList.add("border-transparent","bg-bg/70");
    }
};

updateHeader();

window.addEventListener("scroll", updateHeader, {
    passive:true
});

const observer = new IntersectionObserver(entries=>{

entries.forEach(entry=>{

if(!entry.isIntersecting) return;

navItems.forEach(item=>{

const active=item.getAttribute("href")==="#" + entry.target.id;

item.classList.toggle("text-fg",active);
item.classList.toggle("after:w-full",active);

});

});

},{
threshold:.55
});

document.querySelectorAll("section").forEach(section=>{
observer.observe(section);
});
</script>
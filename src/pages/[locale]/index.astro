---
import Layout from "@layouts/Layout.astro";
import FrontCover from "@components/FrontCover.astro";
import BookExperience from "@components/BookExperience.astro";
import BookProjects from "@components/BookProjects.astro";
import Skills from "@components/Skills.astro";
import BookAbout from "@components/BookAbout.astro";
import BackCover from "@components/BackCover.astro";
import { getSiteConfig, getSiteContent } from "@config";
import { getTranslation, isValidLocale, defaultLocale, type Locale } from "@i18n";

export function getStaticPaths() {
  return [
    { params: { locale: "en" } },
    { params: { locale: "fr" } },
  ];
}

const { locale: rawLocale } = Astro.params;
const locale: Locale = isValidLocale(rawLocale!) ? rawLocale : defaultLocale;

const config = getSiteConfig(locale);
const content = getSiteContent(locale);
const t = getTranslation(locale);

// Titre localisé via les traductions (plus propre que le ternaire)
const pageTitle = `${config.author} — ${t.hero.role || "Full Stack Engineer"}`;
---

<Layout title={pageTitle} description={config.description} locale={locale}>
  <FrontCover {...content.hero} t={t} />
  <BookExperience experience={content.experience} t={t} label={content.sections[0].eyebrow} />
  <BookProjects projects={content.projects} t={t} label={content.sections[1].eyebrow} />
  <Skills skills={content.skills} t={t} label={content.sections[2].eyebrow} />
  <BookAbout {...content.about} name={content.hero.name} t={t} label={content.sections[3].eyebrow} />
  <BackCover contact={content.contact} author={config.author} socialLinks={config.socialLinks} t={t} />
</Layout>

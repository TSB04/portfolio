---
import Header from "@components/Header.astro";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { getSiteConfig, getSiteContent } from "@config";
import TabNav from "@components/TabNav.astro";
import { type Locale } from "../i18n";

import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

const config = getSiteConfig(locale);
const content = getSiteContent(locale);

const {
  title: baseTitle,
  description: baseDescription,
  navLinks,
  lang,
  siteLogo,
  author,
  socialLinks,
  socialImage,
} = config;

const baseUrl = Astro.site?.href || "https://tsb-dev.fr";
const canonicalURL = new URL(Astro.url.pathname, baseUrl).href;
const title = Astro.props.title || baseTitle;
const description = Astro.props.description || baseDescription;
const ogImgUrl = new URL(socialImage, baseUrl).href;
const pageTitle = title ? `${title} | ${config.author}` : config.author;

const currentPath = Astro.url.pathname.replace(/^\/(en|fr)/, "") || "/";
const enUrl = new URL(currentPath, baseUrl).href;
const frUrl = new URL(`/fr${currentPath === "/" ? "" : currentPath}`, baseUrl)
  .href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- Theme initialization -->
    <script is:inline>
      (function () {
        function applyTheme() {
          const theme =
            localStorage.getItem("theme") ||
            (window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light");
          const html = document.documentElement;
          if (theme === "dark") {
            html.classList.add("dark");
            html.style.colorScheme = "dark";
          } else {
            html.classList.remove("dark");
            html.style.colorScheme = "light";
          }
        }
        applyTheme();
        document.addEventListener("astro:after-swap", applyTheme);
      })();
    </script>

    <ClientRouter fallback="swap" />

    <meta name="author" content={author} />
    <meta name="description" content={description} />
    <meta name="keywords" content={config.keywords?.join(", ")} />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="theme-color"
      content="#0e141b"
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />

    <link rel="canonical" href={canonicalURL} />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="fr" href={frUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />

    <title>{pageTitle}</title>

    <Font cssVariable="--font-gabarito" preload />
    <Font cssVariable="--font-be-vietnam-pro" preload />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={author} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "fr_FR"} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImgUrl} />
    <meta property="og:image:alt" content={`${author} portfolio preview`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@tsb04" />
    <meta name="twitter:creator" content="@tsb04" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImgUrl} />
    <meta name="twitter:image:alt" content={`${author} portfolio preview`} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: author,
        url: canonicalURL,
        image: ogImgUrl,
        jobTitle:
          locale === "fr"
            ? "IngÃ©nieur Logiciel Full Stack"
            : "Full Stack Software Engineer",
        worksFor: { "@type": "Organization", name: "MTAE" },
        sameAs: socialLinks.map((link) => link.href),
        description: description,
        knowsLanguage: ["en", "fr"],
      })}
    />

    <script>
      document.addEventListener("keydown", (e) => {
        const container = document.querySelector(".snap-y");
        if (!container) return;
        const pageHeight = window.innerHeight - 80; // 5rem header
        if (e.key === "ArrowDown" || e.key === "PageDown") {
          e.preventDefault();
          container.scrollBy({ top: pageHeight, behavior: "smooth" });
        }
        if (e.key === "ArrowUp" || e.key === "PageUp") {
          e.preventDefault();
          container.scrollBy({ top: -pageHeight, behavior: "smooth" });
        }
      });
    </script>

    <slot name="head" />
  </head>

  <body class="text-fg font-sans antialiased bg-bg" data-book-state="cover">
    <div class="w-full bg-bg">
      <Header
        siteLogo={siteLogo}
        navLinks={navLinks}
        locale={locale}
        transition:persist
      />

      <TabNav sections={content.sections} />
      <div id="book" class="w-full">
        <main class="mx-auto w-full">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>

<script>
  import Lenis from "lenis";
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);
  let dispose: (() => void) | undefined;

  function initialiseBook() {
    dispose?.();
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const desktop = window.matchMedia("(min-width: 1024px)").matches;
    const pages = Array.from(document.querySelectorAll<HTMLElement>("#hero, .carnet-page, #contact"));
    const tabs = Array.from(document.querySelectorAll<HTMLElement>("[data-tab-for]"));
    let lenis: Lenis | undefined;
    let rafId = 0;
    const context = gsap.context(() => {
      if (!reduceMotion && !window.matchMedia("(pointer: coarse)").matches) {
        lenis = new Lenis({ lerp: 0.1, smoothWheel: true });
        const raf = (time: number) => { lenis?.raf(time); rafId = requestAnimationFrame(raf); };
        rafId = requestAnimationFrame(raf);
        lenis.on("scroll", ScrollTrigger.update);
      }
      pages.forEach((page, index) => {
        ScrollTrigger.create({
          trigger: page,
          start: "top center",
          end: "bottom center",
          onToggle: (trigger) => {
            if (!trigger.isActive) return;
            document.body.dataset.bookState = index === 0 ? "cover" : index === pages.length - 1 ? "back" : "page";
            const tabId = page.id.replace(/-\d+$/, "");
            tabs.forEach((tab) => tab.classList.toggle("is-active", tab.dataset.tabFor === tabId));
          },
        });
        if (!reduceMotion && index > 0) {
          gsap.from(page.querySelector(".page-inner, .cover-content"), {
            xPercent: desktop ? 6 : 3,
            rotateY: desktop ? -16 : 0,
            opacity: 0,
            transformPerspective: 1600,
            duration: 0.7,
            ease: "power3.out",
            scrollTrigger: { trigger: page, start: "top 76%", toggleActions: "play none none reverse" },
          });
          const revealTargets = page.querySelectorAll<HTMLElement>(".page-heading, .timeline-entry, .project-card, .skill-card, .portrait");
          if (revealTargets.length) {
            gsap.from(revealTargets, {
              y: 20,
              opacity: 0,
              duration: 0.45,
              stagger: 0.07,
              ease: "power2.out",
              scrollTrigger: { trigger: page, start: "top 68%", toggleActions: "play none none reverse" },
            });
          }
        }
      });
    });
    const navigate = (event: Event) => {
      const anchor = (event.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
      if (!anchor) return;
      const target = document.querySelector<HTMLElement>(anchor.getAttribute("href") || "");
      if (!target) return;
      event.preventDefault();
      lenis ? lenis.scrollTo(target, { duration: 1.1 }) : target.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth" });
    };
    document.addEventListener("click", navigate);
    dispose = () => { document.removeEventListener("click", navigate); cancelAnimationFrame(rafId); lenis?.destroy(); context.revert(); ScrollTrigger.getAll().forEach((trigger) => trigger.kill()); };
  }
  document.addEventListener("astro:page-load", initialiseBook);
  document.addEventListener("astro:before-swap", () => dispose?.());
</script>

# Build-time GitHub App credentials. Never use PUBLIC_ for authentication values.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_INSTALLATION_ID=
# Absolute path on the build machine; the file must be outside public/ and dist/.
GITHUB_PRIVATE_KEY_PATH=
# Alternative for CI: PEM text with escaped newlines. Leave empty when using a path.
GITHUB_PRIVATE_KEY=

# Optional: profile and portfolio selection. Defaults shown below.
GITHUB_OWNER=tsb04
GITHUB_PROJECT_LIMIT=12
# Comma-separated repository names to include; display order is always newest push first.
# Leave empty for active non-forked repos, including private repos accessible to the App.
GITHUB_REPOSITORIES=

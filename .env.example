# Build-time GitHub App credentials. Never use PUBLIC_ for authentication values.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_INSTALLATION_ID=
# Absolute path on the build machine; the file must be outside public/ and dist/.
GITHUB_PRIVATE_KEY_PATH=
# Alternative for CI: PEM text with escaped newlines. Leave empty when using a path.
GITHUB_PRIVATE_KEY=

# Optional: profile and portfolio selection. Defaults shown below.
GITHUB_OWNER=tsb04
GITHUB_PROJECT_LIMIT=0
# 0 means unlimited. Comma-separated repository names to include; display order is always newest push first.
# * publishes metadata for ALL owned non-archived public/private repositories, including forks.
# Leave empty for public only, or specify names for a curated selection.
GITHUB_REPOSITORIES=*
# Additional private component repositories approved for public metadata display.
# These appear under their parent, without adding standalone project cards.
GITHUB_SUBMODULE_REPOSITORIES=
# Optional user token for direct local builds when no App key is available.
# Keep empty unless explicitly using authenticated user access; never use PUBLIC_.
GITHUB_USER_TOKEN=
